# FRED (required for HY OAS and yield curve): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Anthropic (optional; omit or use --no-llm for template commentary)
ANTHROPIC_API_KEY=

# Narrative
BRIEF_LANG=bg
BRIEF_MODEL=claude-sonnet-4-20250514

# Telegram (optional; required for live delivery)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord webhook (optional)
DISCORD_WEBHOOK_URL=

# Healthchecks.io ping on failure (optional)
HEALTHCHECK_URL=

# Storage directory for snapshots and idempotency (default: ./data)
BRIEF_DATA_DIR=./data

# ORBIS GEX sidecar (Phase 2 collector)
ORBIS_SIDECAR_URL=https://orbis-gex.onrender.com

# Optional public URL for Telegram link when using --orbis-html
ORBIS_HTML_PUBLIC_URL=
